# Copy to `.env.local` (never commit `.env.local`).
# cp .env.example .env.local

# --- Supabase (same project as mobile) ---
# You can paste URL + anon key from mobile/.env — use EXPO_PUBLIC_* names or Next names below:
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_publishable_anon_key

# Server-only — required for create-admin script, bootstrap, and admin DB writes.
# Dashboard → Settings → API → service_role (secret). Never ship this to mobile or the browser.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_secret

# One-time /setup page gate (optional if you use npm run create-admin instead)
# ADMIN_SETUP_TOKEN=your_random_secret

# Optional env badge: local | staging | production
# NEXT_PUBLIC_ADMIN_ENV=local

# Local only (`npm run dev`): skip /login and use service-role DB access. Never set in production.
# ADMIN_SKIP_AUTH=1
