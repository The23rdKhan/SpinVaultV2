# Copy to `.env` and fill in values (never commit `.env`).
# cp .env.example .env

# --- Supabase (required for auth + analytics) ---
# Dashboard may label this "publishable" key — use EXPO_PUBLIC_SUPABASE_KEY or legacy EXPO_PUBLIC_SUPABASE_ANON_KEY.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_KEY=your_publishable_or_anon_key_here

# --- Google Sign-In → Supabase signInWithIdToken ---
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-client-id.apps.googleusercontent.com

# --- Google on iOS only (after expo prebuild / dev client) ---
# EXPO_PUBLIC_GOOGLE_IOS_URL_SCHEME=com.googleusercontent.apps.xxxxxxxxxxxxx
# EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# --- Sign in with Apple on Android (Services ID + HTTPS redirect; must match Apple Developer) ---
# EXPO_PUBLIC_APPLE_AUTH_SERVICE_ID=com.your.app.service
# EXPO_PUBLIC_APPLE_AUTH_REDIRECT_URI=https://your.domain/auth/apple/callback

# --- Password reset deep link (must match Supabase Auth → URL Configuration → Redirect URLs) ---
# Default if unset: mobile://reset-password (see app.config.ts scheme)
# EXPO_PUBLIC_SUPABASE_RESET_REDIRECT_URL=mobile://reset-password

# --- RevenueCat (react-native-purchases) — public SDK keys from RevenueCat dashboard ---
# EXPO_PUBLIC_REVENUECAT_APPLE_API_KEY=
# EXPO_PUBLIC_REVENUECAT_GOOGLE_API_KEY=

# --- Expo push (optional; also set project id in app.json / EAS for getExpoPushTokenAsync) ---
# EXPO_PUBLIC_EAS_PROJECT_ID=
