    "eas:build:dev:ios-sim": "npx eas-cli build --profile development-simulator --platform ios",
    "eas:build:dev:ios-device": "npx eas-cli build --profile development --platform ios",
    "eas:build:dev:android": "npx eas-cli build --profile development --platform android",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
